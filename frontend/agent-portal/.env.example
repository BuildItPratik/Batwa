# Copy this to .env and adjust for your environment.
# Local dev (Harsh's backend running via uvicorn):
VITE_API_BASE_URL=http://localhost:8000
VITE_MERCHANT_ID=MER-001
VITE_MERCHANT_NAME=Annapurna Vegetables
VITE_DEMO_MODE=true
VITE_AGENT_ID=AGT-001
VITE_AGENT_NAME=Agent Priya - Downtown

# Optional runtime translation endpoint. The app uses a public fallback when unset.
# VITE_TRANSLATION_API_URL=https://api.mymemory.translated.net/get

# When Atharva deploys the backend, swap this to the Render/Railway URL, e.g.:
# VITE_API_BASE_URL=https://tapwallet-backend.onrender.com

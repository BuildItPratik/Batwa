# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Python tooling caches / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── SQLite database (regenerated via seed.py) ─────────────
*.db

# ── Analytics pipeline runtime artifacts (regenerated by run.py) ──
analytics/warehouse/
analytics/outputs/
analytics/sampledata/

# ── Virtual environments ──────────────────────────────────
venv/
.venv/
env/
.env

# ── Node / Frontend ──────────────────────────────────────
node_modules/
.vite/
.vite-temp/
*.tsbuildinfo
.turbo/
.vercel
.next/

# Env locals (beyond the generic .env above)
.env.local
.env.*.local

# ── OS files ──────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE / Editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Tool state (delta session artifacts) ───────────────────
.delta/

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Root-level lockfiles (stale / not needed) ─────────────
/package-lock.json
/frontend/package-lock.json
/.impeccable/
